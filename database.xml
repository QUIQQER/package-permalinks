<?xml version="1.0" encoding="UTF-8"?>

<database>
    <projects>
        <table name="permalinks" no-project-lang="1">
            <field type="bigint">id</field>
            <field type="string" length="2">lang</field>
            <field type="text" nullable="true" default="null">link</field>
            <primary>id,lang</primary>
            <index>link</index>
        </table>
    </projects>
</database>
